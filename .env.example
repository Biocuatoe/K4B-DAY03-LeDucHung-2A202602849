# ==========================================
# CASUAL INTENT AI CONFIGURATION
# ==========================================
# Groq API Key (Free tier - https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# ==========================================
# MCP TRANSPORT CONFIGURATION
# ==========================================
# Transport mode cho MCP Server:
# - "local": Gọi function Python trực tiếp (backward compatible, mặc định)
# - "stdio": Kết nối tới MCP Server thật qua subprocess JSON-RPC stdio transport
MCP_TRANSPORT=local

# ==========================================
# MULTI-PROVIDER LLM ADAPTER CONFIGURATION
# ==========================================

# Lựa chọn LLM Provider: "gemini", "openai", "anthropic", "openrouter", hoặc "mock" (offline)
LLM_PROVIDER=mock

# Google Gemini API Key (FREE tier - https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-3-5-haiku-20241022

# ==========================================
# MCP SERVER CONFIGURATION (Legacy)
# ==========================================
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000
